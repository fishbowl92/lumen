# 빌드 중 생기는 디버그 심볼 메타 파일
*.pidb.meta
*.pdb.meta
*.mdb.meta

# 크래시 리포트
sysinfo.txt

# 빌드 결과물
*.apk
*.aab
*.unitypackage
*.unitypackage.meta
*.app

# 테스트 결과
/[Tt]est[Rr]esults/

# Addressables
/[Aa]ssets/[Aa]ddressable[Aa]ssets[Dd]ata/*/*.bin*
/[Aa]ssets/[Ss]treamingAssets/aa.meta
/[Aa]ssets/[Ss]treamingAssets/aa/*

# OS
.DS_Store
Thumbs.db
desktop.ini

# WebGL 빌드 zip (itch.io 업로드용, 저장소에는 넣지 않음)
*.zip
